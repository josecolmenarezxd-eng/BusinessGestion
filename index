        function manualBcvRateChange(val) {
            const parsed = parseFloat(String(val).replace(',', '.'));
            if (isNaN(parsed) || parsed <= 0) return;
            if (bcvState.mode === 'TOMORROW') {
                bcvState.tomorrowRate = parsed;
            } else {
                bcvState.todayRate = parsed;
                if (!bcvState.tomorrowRate) bcvState.tomorrowRate = parsed;
            }
            bcvState.lastUpdated = 'Manual ' + getFormattedDateTime();
            saveBcvState();
            convertUsdToVes();
            showToast(`Tasa BCV (${bcvState.mode === 'TOMORROW' ? 'Mañana' : 'Hoy'}) actualizada a ${formatBs(parsed)}.`);
        }

        async function fetchBcvRates(notify = false) {
            const syncBtn = document.getElementById('btn-sync-bcv');
            if (syncBtn) syncBtn.classList.add('animate-spin');

            try {
                let fetchedToday = 0;
                let fetchedNext = 0;

                try {
                    const res = await fetch('https://ve.dolarapi.com/v1/dolares/oficial');
                    if (res.ok) {
                        const data = await res.json();
                        fetchedToday = Number(data.promedio || data.venta || data.compra) || 0;
                    }
                } catch (e) {}

                try {
                    const resHist = await fetch('https://ve.dolarapi.com/v1/historicos/dolares/oficial');
                    if (resHist.ok) {
                        const histData = await resHist.json();
                        if (Array.isArray(histData) && histData.length > 0) {
                            const todayIso = new Date().toISOString().slice(0, 10);
                            const sorted = [...histData].sort((a, b) => String(b.fecha).localeCompare(String(a.fecha)));
                            const futureEntry = sorted.find(entry => String(entry.fecha).slice(0, 10) > todayIso);
                            const latestEntry = sorted[0];

                            if (futureEntry) {
                                fetchedNext = Number(futureEntry.promedio || futureEntry.venta || futureEntry.compra) || 0;
                            } else if (latestEntry) {
                                const latestVal = Number(latestEntry.promedio || latestEntry.venta || latestEntry.compra) || 0;
                                if (latestVal > 0 && fetchedToday > 0 && latestVal !== fetchedToday) {
                                    fetchedNext = latestVal;
                                }
                            }
                        }
                    }
                } catch (e) {}

                try {
                    const res2 = await fetch('https://pydolarve.org/api/v1/dollar?page=bcv');
                    if (res2.ok) {
                        const data2 = await res2.json();
                        const usdMonitor = data2?.monitors?.usd;
                        const price2 = Number(usdMonitor?.price) || 0;
                        const priceOld2 = Number(usdMonitor?.price_old) || 0;

                        if (price2 > 0) {
                            if (!fetchedToday) {
                                fetchedToday = price2;
                            } else if (!fetchedNext && price2 !== fetchedToday) {
                                fetchedNext = price2;
                                if (priceOld2 > 0 && priceOld2 === fetchedToday) {
                                    fetchedToday = priceOld2;
                                }
                            }
                        }
                    }
                } catch (e) {}

                if (fetchedToday > 0) {
                    const hadCustomTomorrow = bcvState.tomorrowRate > 0 && bcvState.tomorrowRate !== bcvState.todayRate;
                    bcvState.todayRate = fetchedToday;

                    if (fetchedNext > 0 && fetchedNext !== fetchedToday) {
                        bcvState.tomorrowRate = fetchedNext;
                    } else if (!hadCustomTomorrow) {
                        bcvState.tomorrowRate = fetchedToday;
                    }

                    bcvState.lastUpdated = getFormattedDateTime();
                    saveBcvState();
                    convertUsdToVes();

                    if (notify) {
                        const nextDiffMsg = bcvState.tomorrowRate !== bcvState.todayRate
                            ? ` | Mañana: ${formatBs(bcvState.tomorrowRate)}`
                            : ' (Mañana aún sin cambio publicado)';
                        showToast(`BCV Hoy: ${formatBs(bcvState.todayRate)}${nextDiffMsg}`);
                    }
                } else if (notify) {
                    showToast('No se pudo conectar con la API del BCV. Puedes escribir la tasa manualmente.', 'warning');
                }
            } catch (err) {
                if (notify) showToast('Error al consultar API BCV. Ingresa el monto manualmente.', 'error');
            } finally {
                if (syncBtn) syncBtn.classList.remove('animate-spin');
            }
        }

