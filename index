        function submitEntry(e) {
            e.preventDefault();
            const id = document.getElementById('entry-product-id').value;
            const inputQty = parseFloat(document.getElementById('entry-qty').value);
            const notes = document.getElementById('entry-notes').value.trim() || 'Llegada de mercancía';

            if (!id || isNaN(inputQty) || inputQty <= 0) return;

            const index = products.findIndex(p => String(p.id) === String(id));
            if (index === -1) return;

            const p = products[index];
            const isPackage = p.unitType === 'Paquetes';
            const addedUnits = isPackage ? inputQty * (p.unitsPerPack || 1) : inputQty;

            if (p.unitType === 'Kg' && inputQty === 999) {
                products[index].stock = 999;
                products[index].unlimitedStock = true;
            } else if (isUnlimitedKg(p)) {
                products[index].stock = addedUnits;
                products[index].unlimitedStock = false;
            } else {
                products[index].stock += addedUnits;
            }

            history.unshift({
                id: generateId(),
                date: getFormattedDateTime(),
                type: 'ENTRADA',
                detail: isPackage ? `${notes} (${formatNumber(inputQty)} paq)` : notes,
                items: [{ name: p.name, qty: addedUnits, unitType: isPackage ? 'Unidades' : p.unitType, price: p.price }],
                total: addedUnits * p.price
            });

            saveData(`Llegada de ${p.name}`);
            renderEntryList();
            selectProductForEntry(id);
            showToast(`+${formatNumber(addedUnits)} ${isPackage ? 'Unidades' : p.unitType} sumados a "${p.name}".`);
        }

