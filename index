            updateStats();

            if (syncChannel) {
                syncChannel.postMessage({
                    type: 'ACCOUNT_UPDATED',
                    sourceDevice: deviceId,
                    changeSummary,
                    payload
                });
            }
            pushRemoteCloudSync(payload, changeSummary);
        }

