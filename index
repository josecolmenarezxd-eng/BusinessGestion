        function saveProduct(e) {
            e.preventDefault();
            const id = document.getElementById('modal-product-id').value;
            const name = document.getElementById('modal-name').value.trim();
            const unitType = document.getElementById('modal-unit-type').value;
            const rawPrice = document.getElementById('modal-price').value.trim();
            let price = rawPrice === '' ? 0 : (parseFloat(rawPrice) || 0);
            if (modalPriceCurrency === 'VES' && price > 0) {
                const rate = getActiveBcvRate();
                if (rate <= 0) {
                    showToast('Ingresa una tasa BCV válida para convertir desde Bolívares.', 'warning');
                    return;
                }
                price = Number((price / rate).toFixed(4));
            }
            const rawStock = parseFloat(document.getElementById('modal-stock').value) || 0;
            const unlimitedCb = document.getElementById('modal-unlimited-kg');
            const unlimitedStock = unitType === 'Kg' && (rawStock === 999 || (unlimitedCb && unlimitedCb.checked));
            const stock = unlimitedStock ? 999 : rawStock;
            const unitsPerPack = unitType === 'Paquetes' ? (parseFloat(document.getElementById('modal-units-per-pack').value) || 1) : 1;

            if (!name) return;

            if (id) {
                const index = products.findIndex(p => String(p.id) === String(id));
                if (index !== -1) {
                    products[index] = { ...products[index], name, unitType, price, stock, unitsPerPack, unlimitedStock };
                    showToast(`Producto "${name}" actualizado.`);
                }
            } else {
                const newProd = {
                    id: generateId(),
                    name,
                    unitType,
                    price,
                    stock,
                    unitsPerPack,
                    unlimitedStock
                };
                products.push(newProd);

                if (stock > 0 || unlimitedStock) {
                    history.unshift({
                        id: generateId(),
                        date: getFormattedDateTime(),
                        type: 'ENTRADA',
                        detail: unlimitedStock ? 'Registro inicial (Peso no definido / ilimitado)' : 'Registro inicial de producto',
                        items: [{ name, qty: unlimitedStock ? 0 : stock, unitType: unitType === 'Paquetes' ? 'Unidades' : unitType, price }],
                        total: unlimitedStock ? 0 : (stock * price)
                    });
                }
                showToast(`Producto "${name}" agregado al inventario.`);
            }

            saveData(`Producto ${id ? 'editado' : 'creado'}: ${name}`);
            closeProductModal();
            renderInventoryTable();
            renderEntryList();
            renderExitList();
            renderPriceAdjustList();
        }

