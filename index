<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Inventario y Ventas</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- PDF.js for reading uploaded PDF inventory reports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: transparent !important;
        }
        #auth-screen {
            background: transparent !important;
        }
        /* Suavizado de bordes con gradiente transparente para integrar tarjetas con el fondo */
        .bg-white {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.55) 100%) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid transparent !important;
            background-clip: padding-box;
            box-shadow:
                0 8px 24px -6px rgba(15, 23, 42, 0.05),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.85),
                0 0 0 1px rgba(148, 163, 184, 0.14) !important;
        }
        .border-slate-100,
        .border-slate-200,
        .border-indigo-100,
        .border-emerald-100,
        .border-amber-100,
        .border-rose-100 {
            border-color: rgba(148, 163, 184, 0.16) !important;
        }
        .border-dashed {
            border-style: dashed !important;
            border-color: rgba(99, 102, 241, 0.25) !important;
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #print-area, #print-area * {
                visibility: visible;
            }
            #print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: white;
                padding: 20px;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
    <!-- Firebase SDK (Compat para funcionar directo en Google Sites) -->
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ================= AUTH SCREEN (LOGIN / REGISTER) ================= -->
    <div id="auth-screen" class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden border border-indigo-100">
            <div class="bg-indigo-600 p-6 text-white text-center">
                <div class="inline-flex bg-indigo-500/50 p-3 rounded-2xl border border-indigo-400/30 mb-3">
                    <i data-lucide="shield-check" class="w-8 h-8"></i>
                </div>
                <h1 class="text-2xl font-bold tracking-tight">GestiónPro Inventarios</h1>
                <p class="text-xs text-indigo-200 mt-1">Acceso privado por cuenta y sincronización en tiempo real</p>
            </div>

            <!-- Auth Mode Tabs -->
            <div class="grid grid-cols-2 bg-slate-100 p-1.5 m-6 mb-0 rounded-xl border border-slate-200">
                <button type="button" id="auth-tab-login" onclick="switchAuthMode('LOGIN')" class="py-2 rounded-lg text-sm font-bold bg-white text-indigo-600 shadow-sm transition-all">
                    Iniciar Sesión
                </button>
                <button type="button" id="auth-tab-register" onclick="switchAuthMode('REGISTER')" class="py-2 rounded-lg text-sm font-bold text-slate-600 hover:text-slate-900 transition-all">
                    Crear Cuenta
                </button>
            </div>

            <!-- Login Form -->
            <form id="login-form" onsubmit="handleLogin(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Nombre de Usuario</label>
                    <input type="text" id="login-username" required autocomplete="username" placeholder="Ej. bodega_central" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Contraseña</label>
                    <input type="password" id="login-password" required autocomplete="current-password" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                </div>
                <p id="login-error" class="text-xs font-semibold text-rose-600 hidden"></p>
                <button type="submit" id="login-submit-btn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition-colors shadow-md">
                    Entrar a mi Inventario
                </button>
            </form>

            <!-- Register Form -->
            <form id="register-form" onsubmit="handleRegister(event)" class="p-6 space-y-4 hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Nuevo Usuario (único, sin espacios)</label>
                    <input type="text" id="reg-username" required minlength="3" maxlength="24" placeholder="Ej. abastos_maria" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Contraseña Segura</label>
                    <input type="password" id="reg-password" required minlength="8" placeholder="Mín. 8 caracteres, 1 Mayúscula y 1 Número" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                    <p class="text-[11px] text-slate-500 mt-1">Reglas: Mínimo 8 caracteres, al menos 1 letra mayúscula y 1 número.</p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Confirmar Contraseña</label>
                    <input type="password" id="reg-password-confirm" required minlength="8" placeholder="Repite tu contraseña" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                </div>
                <p id="register-status" class="text-xs font-semibold text-indigo-600 hidden"></p>
                <p id="register-error" class="text-xs font-semibold text-rose-600 hidden"></p>
                <button type="submit" id="register-submit-btn" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition-colors shadow-md disabled:opacity-60">
                    Registrar Cuenta Privada
                </button>
            </form>
        </div>
    </div>

    <!-- ================= MAIN APP WRAPPER (PROTECTED BY AUTH) ================= -->
    <div id="app-wrapper" class="hidden flex-col min-h-screen">

    <!-- Header -->
    <header class="bg-indigo-600 text-white shadow-md no-print">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-indigo-500/50 p-2 rounded-xl border border-indigo-400/30">
                    <i data-lucide="package-open" class="w-7 h-7"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold tracking-tight">GestiónPro Inventarios</h1>
                        <span id="sync-status-badge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-200 border border-emerald-400/30">En línea</span>
                    </div>
                    <p class="text-xs text-indigo-200">Cuenta: <strong id="header-username" class="text-white">---</strong> • <button type="button" onclick="logoutAccount()" class="underline hover:text-white font-semibold">Cerrar sesión</button></p>
                </div>
            </div>
            <!-- BCV Dollar Rate Widget in Header -->
            <div class="flex flex-wrap items-center gap-2 bg-indigo-800/70 px-3 py-2 rounded-xl border border-indigo-400/30 text-xs">
                <div class="flex items-center gap-1.5">
                    <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 px-2 py-0.5 rounded-md font-bold">BCV</span>
                    <div class="flex bg-indigo-950/60 p-0.5 rounded-lg border border-indigo-500/30">
                        <button type="button" onclick="setBcvDayMode('TODAY')" id="btn-bcv-today" class="px-2 py-0.5 rounded-md font-bold bg-white text-indigo-700 transition-all">Hoy</button>
                        <button type="button" onclick="setBcvDayMode('TOMORROW')" id="btn-bcv-tomorrow" class="px-2 py-0.5 rounded-md font-medium text-indigo-200 hover:text-white transition-all">Mañana</button>
                    </div>
                </div>
                <div class="flex items-center gap-1">
                    <span class="text-indigo-200 font-medium">Bs.</span>
                    <input type="number" step="any" min="0.01" id="bcv-rate-input" onchange="manualBcvRateChange(this.value)" class="w-20 bg-indigo-950/70 text-white font-bold px-2 py-1 rounded-lg border border-indigo-400/40 focus:outline-none focus:border-emerald-400 text-right" placeholder="0.00" title="Tasa BCV (Editable manualmente)">
                </div>
                <button type="button" onclick="fetchBcvRates(true)" id="btn-sync-bcv" title="Actualizar tasa BCV desde API" class="p-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                </button>
                <button type="button" onclick="openConverterModal()" title="Abrir Conversor USD ⇄ Bs" class="px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg transition-colors flex items-center gap-1 shadow-sm">
                    <i data-lucide="arrow-left-right" class="w-3.5 h-3.5"></i> Conversor
                </button>
                <button type="button" onclick="toggleFullScreen()" id="btn-fullscreen" title="Pantalla Completa" class="p-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors">
                    <i data-lucide="maximize" class="w-3.5 h-3.5"></i>
                </button>
            </div>
            <!-- Navigation Tabs -->
            <nav class="flex flex-wrap justify-center gap-1 bg-indigo-700/60 p-1.5 rounded-xl border border-indigo-500/30 w-full md:w-auto">
                <button onclick="switchTab('inventory')" id="tab-inventory" class="flex-1 md:flex-none px-3.5 py-2 rounded-lg text-sm font-medium transition-all bg-white text-indigo-600 shadow-sm flex items-center justify-center gap-2">
                    <i data-lucide="boxes" class="w-4 h-4"></i> Inventario
                </button>
                <button onclick="switchTab('entry')" id="tab-entry" class="flex-1 md:flex-none px-3.5 py-2 rounded-lg text-sm font-medium transition-all text-indigo-100 hover:bg-indigo-600 flex items-center justify-center gap-2">
                    <i data-lucide="arrow-down-circle" class="w-4 h-4"></i> Llegada
                </button>
                <button onclick="switchTab('exit')" id="tab-exit" class="flex-1 md:flex-none px-3.5 py-2 rounded-lg text-sm font-medium transition-all text-indigo-100 hover:bg-indigo-600 flex items-center justify-center gap-2">
                    <i data-lucide="shopping-cart" class="w-4 h-4"></i> Salida / Venta
                </button>
                <button onclick="switchTab('prices')" id="tab-prices" class="flex-1 md:flex-none px-3.5 py-2 rounded-lg text-sm font-medium transition-all text-indigo-100 hover:bg-indigo-600 flex items-center justify-center gap-2">
                    <i data-lucide="percent" class="w-4 h-4"></i> Precios
                </button>
                <button onclick="switchTab('fiados')" id="tab-fiados" class="flex-1 md:flex-none px-3.5 py-2 rounded-lg text-sm font-medium transition-all text-indigo-100 hover:bg-indigo-600 flex items-center justify-center gap-2">
                    <i data-lucide="users" class="w-4 h-4"></i> Fiados
                </button>
                <button onclick="switchTab('earnings')" id="tab-earnings" class="flex-1 md:flex-none px-3.5 py-2 rounded-lg text-sm font-medium transition-all text-indigo-100 hover:bg-indigo-600 flex items-center justify-center gap-2">
                    <i data-lucide="trending-up" class="w-4 h-4"></i> Ganancias
                </button>
                <button onclick="switchTab('history')" id="tab-history" class="flex-1 md:flex-none px-3.5 py-2 rounded-lg text-sm font-medium transition-all text-indigo-100 hover:bg-indigo-600 flex items-center justify-center gap-2">
                    <i data-lucide="history" class="w-4 h-4"></i> Historial
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6">

        <!-- ================= SECTION 1: INVENTORY ================= -->
        <section id="section-inventory" class="space-y-6">
            <!-- Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 no-print">
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-400 uppercase">Productos Registrados</p>
                        <p id="stat-total-products" class="text-2xl font-bold text-indigo-600 mt-1">0</p>
                    </div>
                    <div class="bg-indigo-50 text-indigo-600 p-3 rounded-xl">
                        <i data-lucide="package" class="w-6 h-6"></i>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-400 uppercase">Valor Total Inventario</p>
                        <p id="stat-total-value" class="text-2xl font-bold text-emerald-600 mt-1">$0.00</p>
                    </div>
                    <div class="bg-emerald-50 text-emerald-600 p-3 rounded-xl">
                        <i data-lucide="dollar-sign" class="w-6 h-6"></i>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-400 uppercase">Fiados Pendientes</p>
                        <p id="stat-total-fiados" class="text-2xl font-bold text-amber-600 mt-1">$0.00</p>
                    </div>
                    <div class="bg-amber-50 text-amber-600 p-3 rounded-xl">
                        <i data-lucide="wallet" class="w-6 h-6"></i>
                    </div>
                </div>
            </div>

            <!-- Action Header -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-4 rounded-2xl shadow-sm border border-slate-100 no-print">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Inventario Actual</h2>
                    <p class="text-sm text-slate-500">Gestiona tus artículos por unidades o peso detallado.</p>
                </div>
                <div class="flex flex-wrap gap-2 w-full sm:w-auto">
                    <button onclick="openProductModal()" class="flex-1 sm:flex-none bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl font-medium text-sm transition-colors flex items-center justify-center gap-2 shadow-sm">
                        <i data-lucide="plus" class="w-4 h-4"></i> + Nuevo Producto
                    </button>
                    <button onclick="printInventory()" class="flex-1 sm:flex-none bg-slate-800 hover:bg-slate-900 text-white px-4 py-2.5 rounded-xl font-medium text-sm transition-colors flex items-center justify-center gap-2 shadow-sm">
                        <i data-lucide="file-down" class="w-4 h-4"></i> Descargar PDF
                    </button>
                    <button onclick="exportTxtInventory()" class="flex-1 sm:flex-none bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2.5 rounded-xl font-medium text-sm transition-colors flex items-center justify-center gap-2 shadow-sm">
                        <i data-lucide="file-text" class="w-4 h-4"></i> Descargar TXT
                    </button>
                </div>
            </div>

            <!-- Search bar for Inventory -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex gap-4 items-center no-print">
                <div class="relative flex-1">
                    <i data-lucide="search" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="inventory-search" oninput="debouncedRender('inventory')" placeholder="Buscar producto en inventario por nombre..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                </div>
            </div>

            <!-- Printable Area -->
            <div id="print-area" class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="p-6 border-b border-slate-200 hidden print:block">
                    <div class="flex justify-between items-center">
                        <div>
                            <h1 class="text-2xl font-bold text-slate-900">Reporte de Inventario Actual</h1>
                            <p class="text-sm text-slate-500 mt-1" id="print-date"></p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs font-semibold text-slate-400 uppercase">Valor Total Estimado</p>
                            <p id="print-total-val" class="text-lg font-bold text-slate-900"></p>
                        </div>
                    </div>
                </div>
                <div class="overflow-x-auto max-h-[380px] overflow-y-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="sticky top-0 z-10 bg-slate-50 shadow-sm">
                            <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-100">
                                <th class="p-4 font-semibold">Producto</th>
                                <th class="p-4 font-semibold">Medida</th>
                                <th class="p-4 font-semibold">Stock Disponible</th>
                                <th class="p-4 font-semibold">Precio Unitario</th>
                                <th class="p-4 font-semibold">Subtotal ($)</th>
                                <th class="p-4 font-semibold text-right no-print">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-table-body" class="divide-y divide-slate-100 text-sm">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Deep Bottom Action: Update Inventory from PDF or TXT -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-dashed border-slate-300 flex flex-col sm:flex-row justify-between items-center gap-4 no-print">
                <div class="flex items-center gap-3 text-center sm:text-left">
                    <div class="bg-indigo-50 text-indigo-600 p-3 rounded-xl shrink-0">
                        <i data-lucide="file-up" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Cargar PDF o Importar TXT</h3>
                        <p class="text-xs text-slate-500">Sube tu archivo PDF de respaldo o importa/exporta en tu formato TXT clásico (Nombre: unidad,cantidad,precio).</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2 w-full sm:w-auto shrink-0">
                    <input type="file" id="pdf-upload-input" accept="application/pdf" class="hidden" onchange="handlePdfUpload(event)">
                    <input type="file" id="txt-upload-input" accept=".txt,text/plain" class="hidden" onchange="handleTxtUpload(event)">
                    <button onclick="document.getElementById('pdf-upload-input').click()" class="flex-1 sm:flex-none bg-slate-100 hover:bg-indigo-600 text-slate-700 hover:text-white border border-slate-200 hover:border-indigo-600 px-4 py-2.5 rounded-xl font-medium text-sm transition-all flex items-center justify-center gap-2">
                        <i data-lucide="file-text" class="w-4 h-4"></i> Cargar PDF
                    </button>
                    <button onclick="document.getElementById('txt-upload-input').click()" class="flex-1 sm:flex-none bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-medium text-sm transition-all flex items-center justify-center gap-2">
                        <i data-lucide="upload" class="w-4 h-4"></i> Importar TXT
                    </button>
                </div>
            </div>
        </section>

        <!-- ================= SECTION 2: ENTRY (LLEGADA) ================= -->
        <section id="section-entry" class="space-y-6 hidden">
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Entrada de Mercancía (Llegada)</h2>
                    <p class="text-sm text-slate-500">Busca un producto existente para sumar stock o registra uno nuevo si no existe.</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-500 uppercase">Moneda precios:</span>
                    <div class="inline-flex rounded-lg bg-slate-100 p-0.5 border border-slate-200">
                        <button type="button" onclick="setEntryCurrency('USD')" id="btn-entry-usd" class="px-2.5 py-1 rounded-md text-xs font-bold bg-indigo-600 text-white shadow-sm transition-all">USD ($)</button>
                        <button type="button" onclick="setEntryCurrency('VES')" id="btn-entry-ves" class="px-2.5 py-1 rounded-md text-xs font-bold text-slate-600 hover:text-slate-900 transition-all">Bs. (BCV)</button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Search & Product Selection Column -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 space-y-4">
                        <div class="relative">
                            <i data-lucide="search" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                            <input type="text" id="entry-search" oninput="debouncedRender('entry')" placeholder="Escribe el nombre del producto que llegó..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 text-sm">
                        </div>

                        <!-- Button to add new product when search doesn't match or list is empty -->
                        <div id="entry-not-found" class="hidden p-4 bg-amber-50 border border-amber-200 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-3">
                            <div class="flex items-center gap-2 text-amber-800">
                                <i data-lucide="info" class="w-5 h-5 shrink-0"></i>
                                <span class="text-sm font-medium">No se encontró el producto en el inventario.</span>
                            </div>
                            <button onclick="openProductModalPreFilled()" class="w-full sm:w-auto bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition-colors flex items-center justify-center gap-2 shadow-sm">
                                <i data-lucide="plus-circle" class="w-4 h-4"></i> + Añadir nuevo producto
                            </button>
                        </div>

                        <div id="entry-product-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[460px] overflow-y-auto pr-1">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>

                <!-- Entry Action Form -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 h-fit space-y-4">
