        function convertUsdToVes() {
            const usdEl = document.getElementById('conv-usd-input');
            const vesEl = document.getElementById('conv-ves-input');
            if (!usdEl || !vesEl) return;
            const usd = parseFloat(usdEl.value);
            const rate = getActiveBcvRate();
            if (isNaN(usd) || usd <= 0 || rate <= 0) {
                vesEl.value = '';
                return;
            }
            vesEl.value = (usd * rate).toFixed(2);
        }

