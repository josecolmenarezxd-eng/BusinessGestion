            const ves = parseFloat(vesEl.value);
            const rate = getActiveBcvRate();
            if (isNaN(ves) || ves <= 0 || rate <= 0) {
                usdEl.value = '';
                return;
            }
            usdEl.value = (ves / rate).toFixed(2);
