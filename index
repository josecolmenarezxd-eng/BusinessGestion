            clock: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>'
        };

        const renderTimers = {};
        function debouncedRender(section) {
            clearTimeout(renderTimers[section]);
            renderTimers[section] = setTimeout(() => {
                if (section === 'inventory') renderInventoryTable();
                else if (section === 'entry') renderEntryList();
                else if (section === 'exit') renderExitList();
                else if (section === 'prices') renderPriceAdjustList();
                else if (section === 'fiados') renderFiados();
            }, 90);
        }

        // ================= STATE MANAGEMENT, AUTH & ISOLATED ACCOUNT STORAGE =================
        let currentUser = null;
        let currentSyncRoom = '';
        let deviceId = 'dev_' + Math.random().toString(36).slice(2, 9);
        let lastSyncedRevision = 0;
        let pendingOfflineSync = false;
        let syncChannel = null;
        let isPublishingAccount = false;

        let products = [];
        let history = [];
        let cart = [];
        let transactionType = 'VENTA';
        let entryCurrency = 'USD';
        let productPriceViews = {};

        const SafeStorage = {
            get(key) {
                try {
                    const val = window.localStorage.getItem(key);
                    if (val !== null) return JSON.parse(val);
                } catch (e) {}
                try {
                    if (window.name && window.name.startsWith('GP_DATA:')) {
                        const parsed = JSON.parse(window.name.slice(8));
                        return parsed[key] !== undefined ? parsed[key] : null;
                    }
                } catch (e) {}
                return null;
            },
            set(key, value) {
                let saved = false;
                try {
                    window.localStorage.setItem(key, JSON.stringify(value));
                    saved = true;
                } catch (e) {}
                try {
                    let current = {};
                    if (window.name && window.name.startsWith('GP_DATA:')) {
                        current = JSON.parse(window.name.slice(8)) || {};
                    }
                    current[key] = value;
                    window.name = 'GP_DATA:' + JSON.stringify(current);
                    saved = true;
                } catch (e) {}
                return saved;
            },
            remove(key) {
                try { window.localStorage.removeItem(key); } catch (e) {}
                try {
                    if (window.name && window.name.startsWith('GP_DATA:')) {
                        const current = JSON.parse(window.name.slice(8)) || {};
                        delete current[key];
                        window.name = 'GP_DATA:' + JSON.stringify(current);
                    }
                } catch (e) {}
            }
        };

        async function hashPassword(password) {
            try {
                if (window.crypto && window.crypto.subtle) {
                    const msgUint8 = new TextEncoder().encode(password + '_GP_SALT_2026');
                    const hashBuffer = await crypto.subtle.digest('SHA-256', msgUint8);
                    const hashArray = Array.from(new Uint8Array(hashBuffer));
                    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
                }
            } catch (e) {}
            let h1 = 0x811c9dc5;
            const salted = password + '_GP_SALT_2026';
            for (let i = 0; i < salted.length; i++) {
                h1 ^= salted.charCodeAt(i);
                h1 = Math.imul(h1, 0x01000193);
            }
            return (h1 >>> 0).toString(16).padStart(8, '0');
        }

        // ================= CONFIGURACIÓN DE FIREBASE (NUBE REAL PARA GOOGLE SITES) =================
        // IMPORTANTE: Reemplaza estos valores con los de tu proyecto gratuito en console.firebase.google.com
        const firebaseConfig = {
            apiKey: "TU_API_KEY",
            authDomain: "TU_PROYECTO.firebaseapp.com",
            databaseURL: "https://TU_PROYECTO-default-rtdb.firebaseio.com",
            projectId: "TU_PROYECTO",
            storageBucket: "TU_PROYECTO.appspot.com",
            messagingSenderId: "TU_SENDER_ID",
            appId: "TU_APP_ID"
        };

        let cloudDb = null;
        let isFirebaseConfigured = Boolean(
            firebaseConfig &&
            firebaseConfig.apiKey &&
            firebaseConfig.apiKey !== "TU_API_KEY" &&
            firebaseConfig.databaseURL &&
            !firebaseConfig.databaseURL.includes("TU_PROYECTO")
        );

        if (isFirebaseConfigured && typeof firebase !== 'undefined') {
            try {
                if (!firebase.apps.length) {
                    firebase.initializeApp(firebaseConfig);
                }
                cloudDb = firebase.database();
            } catch (e) {
                console.error("Error inicializando Firebase:", e);
                cloudDb = null;
            }
        }

        let activeFirebaseListener = null;
        let activeUsersListener = null;
        let activeSessionListener = null;
        let globalBusChannel = null;

        function isCloudConnected() {
            return Boolean(cloudDb && navigator.onLine);
        }

        function updateCloudStatusIndicators() {
            const badge = document.getElementById('sync-status-badge');
            const authScreen = document.getElementById('auth-screen');
            let authBanner = document.getElementById('cloud-config-banner');

            if (!authBanner && authScreen) {
                const card = authScreen.querySelector('.bg-white');
                if (card) {
                    authBanner = document.createElement('div');
                    authBanner.id = 'cloud-config-banner';
                    authBanner.className = 'mx-6 mt-4 p-3 rounded-xl text-xs font-medium border';
                    const tabsEl = document.getElementById('auth-tab-login')?.parentElement;
                    if (tabsEl && tabsEl.parentElement) {
                        tabsEl.parentElement.insertBefore(authBanner, tabsEl);
                    }
                }
            }

            if (authBanner) {
                if (!isFirebaseConfigured) {
                    authBanner.className = 'mx-6 mt-4 p-3 rounded-xl text-xs font-medium border bg-amber-50 text-amber-900 border-amber-200';
                    authBanner.innerHTML = '<strong>Modo Local (sin nube configurada):</strong> Las cuentas creadas aquí solo existirán en este dispositivo hasta que pegues tu <code>firebaseConfig</code> en el HTML.';
                } else if (!navigator.onLine) {
                    authBanner.className = 'mx-6 mt-4 p-3 rounded-xl text-xs font-medium border bg-rose-50 text-rose-800 border-rose-200';
                    authBanner.innerHTML = '<strong>Sin conexión a internet:</strong> Conectando con la nube cuando vuelva la red.';
                } else {
                    authBanner.className = 'mx-6 mt-4 p-3 rounded-xl text-xs font-medium border bg-emerald-50 text-emerald-900 border-emerald-200';
                    authBanner.innerHTML = '<strong>Nube activa (Firebase):</strong> Cuentas, sesiones y datos sincronizados entre laptop, celular y otros dispositivos.';
                }
            }

            if (badge) {
                if (!isFirebaseConfigured) {
                    badge.innerText = 'Solo Local';
                    badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/30 text-amber-200 border border-amber-400/40';
                } else if (!navigator.onLine) {
                    badge.innerText = 'Offline (Local)';
                    badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/30 text-amber-200 border border-amber-400/40';
                } else if (pendingOfflineSync) {
                    badge.innerText = 'Sincronizando...';
                    badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/30 text-amber-200 border border-amber-400/40';
                } else {
                    badge.innerText = 'Nube Activa';
                    badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-200 border border-emerald-400/30';
                }
            }
        }

        function sanitizeCloudKey(str) {
            return String(str || '').trim().toLowerCase().replace(/[.#$\[\]\/]/g, '_');
        }

        function validatePasswordRules(password) {
            if (typeof password !== 'string' || password.length < 8) {
                return 'La contraseña debe tener al menos 8 caracteres.';
            }
            if (!/[A-Z]/.test(password)) {
                return 'La contraseña debe incluir al menos una letra mayúscula.';
            }
            if (!/[0-9]/.test(password)) {
                return 'La contraseña debe incluir al menos un número.';
            }
            return null;
        }

        function switchAuthMode(mode) {
            const loginForm = document.getElementById('login-form');
            const regForm = document.getElementById('register-form');
            const tabLogin = document.getElementById('auth-tab-login');
            const tabReg = document.getElementById('auth-tab-register');
            const loginErr = document.getElementById('login-error');
            const regErr = document.getElementById('register-error');
            const regStatus = document.getElementById('register-status');

            if (loginErr) loginErr.classList.add('hidden');
            if (regErr) regErr.classList.add('hidden');
            if (regStatus) regStatus.classList.add('hidden');

            if (mode === 'REGISTER') {
                if (loginForm) loginForm.classList.add('hidden');
                if (regForm) regForm.classList.remove('hidden');
                if (tabReg) tabReg.className = 'py-2 rounded-lg text-sm font-bold bg-white text-indigo-600 shadow-sm transition-all';
                if (tabLogin) tabLogin.className = 'py-2 rounded-lg text-sm font-bold text-slate-600 hover:text-slate-900 transition-all';
            } else {
                if (regForm) regForm.classList.add('hidden');
                if (loginForm) loginForm.classList.remove('hidden');
                if (tabLogin) tabLogin.className = 'py-2 rounded-lg text-sm font-bold bg-white text-indigo-600 shadow-sm transition-all';
                if (tabReg) tabReg.className = 'py-2 rounded-lg text-sm font-bold text-slate-600 hover:text-slate-900 transition-all';
            }
            updateCloudStatusIndicators();
        }

        function sleepMs(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        function setPendingAccountQueue(userRecord) {
            const queue = SafeStorage.get('gp_pending_account_publishes') || {};
            queue[userRecord.username] = userRecord;
            SafeStorage.set('gp_pending_account_publishes', queue);
        }

        function clearPendingAccountQueue(username) {
            const queue = SafeStorage.get('gp_pending_account_publishes') || {};
            if (queue[username]) {
                delete queue[username];
                SafeStorage.set('gp_pending_account_publishes', queue);
            }
        }

        // Canal global entre pestañas para detectar creación de cuentas, cierre de sesión y datos
        function initGlobalPageBus() {
            if (!('BroadcastChannel' in window)) return;
            if (globalBusChannel) globalBusChannel.close();
            globalBusChannel = new BroadcastChannel('gp_global_account_bus');
            globalBusChannel.onmessage = (event) => {
                const msg = event.data;
                if (!msg || msg.sourceDevice === deviceId) return;

                if (msg.type === 'ACCOUNT_CREATED' && msg.user) {
                    const users = SafeStorage.get('gp_users_registry') || {};
                    users[msg.user.username] = msg.user;
                    SafeStorage.set('gp_users_registry', users);
                    if (msg.initialPayload) {
                        SafeStorage.set(`gp_account_data_${msg.user.username}`, msg.initialPayload);
                    }
                    showToast(`Cuenta "${msg.user.username}" detectada desde otro dispositivo/pestaña.`);
                }

                if (msg.type === 'SESSION_EVENT' && currentUser && msg.username === currentUser) {
                    if (msg.action === 'LOGGED_OUT') {
                        // Guardar datos locales y refrescar estado de nube sin borrar datos de la cuenta
                        if (msg.latestPayload && Number(msg.latestPayload.revision) > Number(lastSyncedRevision)) {
                            applyIncomingAccountSync(msg.latestPayload, 'Datos guardados al cerrar sesión en otro dispositivo');
                        }
                    }
                }
            };
        }

        function broadcastGlobalEvent(eventObj) {
            if (globalBusChannel) {
                try {
                    globalBusChannel.postMessage({ ...eventObj, sourceDevice: deviceId });
                } catch (e) {}
            }
        }

        async function publishAccountOnce(userRecord) {
            if (!cloudDb) {
                throw new Error('Firebase no está configurado');
            }
            const safeUser = sanitizeCloudKey(userRecord.username);
            await cloudDb.ref(`users/${safeUser}`).set({
                username: userRecord.username,
                passwordHash: userRecord.passwordHash,
                syncRoom: userRecord.username,
                createdAt: userRecord.createdAt || Date.now()
            });
            await cloudDb.ref(`account_events/${safeUser}`).set({
                event: 'ACCOUNT_CREATED',
                username: userRecord.username,
                sourceDevice: deviceId,
                timestamp: Date.now()
            });
            return true;
        }

        async function publishAccountToCloudWithRetry(userRecord, onAttemptStatus = null) {
            if (!cloudDb) {
                if (onAttemptStatus) {
                    onAttemptStatus('Aviso: Falta configurar Firebase en el HTML. La cuenta se guardó solo en este dispositivo.');
                }
                return false;
            }
            setPendingAccountQueue(userRecord);
            let attempt = 0;

            while (attempt < 5) {
                attempt += 1;
                if (onAttemptStatus) {
                    onAttemptStatus(`Guardando cuenta "${userRecord.username}" en la nube (intento ${attempt})...`);
                }

                try {
                    if (navigator.onLine) {
                        await publishAccountOnce(userRecord);
                        clearPendingAccountQueue(userRecord.username);
                        return true;
                    }
                } catch (err) {
                    console.error('Error guardando cuenta en Firebase:', err);
                }

                const waitTime = Math.min(5000, 1000 * attempt);
                if (onAttemptStatus) {
                    onAttemptStatus(`Sin respuesta de red. Reintentando en ${Math.round(waitTime / 1000)}s...`);
                }
                await sleepMs(waitTime);
            }
            return false;
        }

        async function flushPendingAccountPublishes() {
            if (!cloudDb || !navigator.onLine) return;
            const queue = SafeStorage.get('gp_pending_account_publishes') || {};
            const usernames = Object.keys(queue);
            if (usernames.length === 0) return;

            for (const uname of usernames) {
                const record = queue[uname];
                if (!record) continue;
                try {
                    await publishAccountOnce(record);
                    clearPendingAccountQueue(uname);
                    showToast(`Cuenta "${uname}" sincronizada con la nube.`);
                } catch (e) {}
            }
        }

        async function fetchAccountFromCloud(username) {
            if (!cloudDb || !navigator.onLine) return null;
            try {
                const safeUser = sanitizeCloudKey(username);
                const snapshot = await cloudDb.ref(`users/${safeUser}`).once('value');
                return snapshot.exists() ? snapshot.val() : null;
            } catch (e) {
                console.error('Error leyendo cuenta desde Firebase:', e);
            }
            return null;
        }

        async function handleRegister(e) {
            e.preventDefault();
            if (isPublishingAccount) return;

            const rawUser = document.getElementById('reg-username').value.trim().toLowerCase();
            const pwd = document.getElementById('reg-password').value;
            const pwdConfirm = document.getElementById('reg-password-confirm').value;
            const errEl = document.getElementById('register-error');
            const statusEl = document.getElementById('register-status');
            const submitBtn = document.getElementById('register-submit-btn');

            errEl.classList.add('hidden');
            statusEl.classList.add('hidden');

            if (!/^[a-z0-9_.-]{3,24}$/.test(rawUser)) {
                errEl.innerText = 'El usuario debe tener 3-24 caracteres (solo letras, números, punto o guion bajo, sin espacios).';
                errEl.classList.remove('hidden');
                return;
            }

            const pwdError = validatePasswordRules(pwd);
            if (pwdError) {
                errEl.innerText = pwdError;
                errEl.classList.remove('hidden');
                return;
            }

            if (pwd !== pwdConfirm) {
                errEl.innerText = 'Las contraseñas no coinciden.';
                errEl.classList.remove('hidden');
                return;
            }

            isPublishingAccount = true;
            submitBtn.disabled = true;
            statusEl.innerText = 'Verificando disponibilidad del usuario...';
            statusEl.classList.remove('hidden');

            try {
                const users = SafeStorage.get('gp_users_registry') || {};
                const cloudUser = await fetchAccountFromCloud(rawUser);
                if (users[rawUser] || cloudUser) {
                    if (cloudUser) {
                        users[rawUser] = cloudUser;
                        SafeStorage.set('gp_users_registry', users);
                    }
                    errEl.innerText = 'Ese nombre de usuario ya existe. Inicia sesión con tu cuenta.';
                    errEl.classList.remove('hidden');
                    statusEl.classList.add('hidden');
                    return;
                }

                const pwdHash = await hashPassword(pwd);
                const newUserRecord = {
                    username: rawUser,
                    passwordHash: pwdHash,
                    syncRoom: rawUser,
                    createdAt: Date.now()
                };
                users[rawUser] = newUserRecord;
                SafeStorage.set('gp_users_registry', users);

                const accountKey = `gp_account_data_${rawUser}`;
                const initialRev = Date.now();
                const initialPayload = {
                    products: [],
                    history: [],
                    productPriceViews: {},
                    revision: initialRev
                };
                SafeStorage.set(accountKey, initialPayload);

                broadcastGlobalEvent({
                    type: 'ACCOUNT_CREATED',
                    user: newUserRecord,
                    initialPayload
                });

                const published = await publishAccountToCloudWithRetry(newUserRecord, (msg) => {
                    statusEl.innerText = msg;
                });

                statusEl.innerText = published ? '¡Cuenta guardada en la nube! Entrando...' : 'Entrando en modo local...';
                startUserSession(rawUser, rawUser);
                lastSyncedRevision = initialRev;
                await pushRemoteCloudSync(initialPayload, 'Cuenta creada y sincronizada');
                showToast(
                    published
                        ? `¡Cuenta "${rawUser}" creada y disponible en todos tus dispositivos!`
                        : `Cuenta "${rawUser}" creada localmente. Configura Firebase para entrar desde otros dispositivos.`,
                    published ? 'success' : 'warning'
                );
            } finally {
                isPublishingAccount = false;
                submitBtn.disabled = false;
            }
        }

        async function handleLogin(e) {
            e.preventDefault();
            const rawUser = document.getElementById('login-username').value.trim().toLowerCase();
            const pwd = document.getElementById('login-password').value;
            const errEl = document.getElementById('login-error');
            const submitBtn = document.getElementById('login-submit-btn');

            errEl.classList.add('hidden');
            submitBtn.disabled = true;

            try {
                const users = SafeStorage.get('gp_users_registry') || {};
                const cloudRecord = await fetchAccountFromCloud(rawUser);
                let userRecord = cloudRecord || users[rawUser];
                if (cloudRecord) {
                    users[rawUser] = cloudRecord;
                    SafeStorage.set('gp_users_registry', users);
                }

                const pwdHash = await hashPassword(pwd);

                if (!userRecord || userRecord.passwordHash !== pwdHash) {
                    if (!isFirebaseConfigured && !users[rawUser]) {
                        errEl.innerText = 'No se encontró la cuenta en este dispositivo y Firebase no está configurado. Revisa el banner arriba.';
                    } else {
                        errEl.innerText = 'Usuario o contraseña incorrectos.';
