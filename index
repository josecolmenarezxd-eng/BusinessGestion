        function exportTxtInventory() {
            let lines = ['=== INVENTARIO ==='];
            products.forEach(p => {
                lines.push(`${p.name}: ${p.unitType},${p.stock},${p.price}${p.unitType === 'Paquetes' ? `,${p.unitsPerPack || 1}` : ''}`);
            });

            lines.push('\n=== FIADOS ===');
            history.filter(h => h.type === 'FIADO').forEach(f => {
                const itemsStr = f.items.map(i => `${i.name}|${i.qty}|${i.unitType}|${i.price}`).join(';');
                lines.push(`${f.clientName || f.detail}|${f.date}|${f.paid ? 'PAGADO' : 'PENDIENTE'}|${f.total}|${itemsStr}`);
            });

            lines.push('\n=== HISTORIAL ===');
            history.forEach(h => {
                const itemsStr = h.items.map(i => `${i.name}|${i.qty}|${i.unitType}|${i.price}`).join(';');
                lines.push(`${h.date}|${h.type}|${h.detail}|${h.total}|${itemsStr}`);
            });

            const blob = new Blob([lines.join('\n')], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `respaldo_inventario_${new Date().toISOString().slice(0, 10)}.txt`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Archivo TXT descargado correctamente.');
        }

        function handleTxtUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const content = e.target.result;
                const rawLines = content.split(/\r?\n/);
                let currentSection = 'INVENTARIO';
                let addedCount = 0;
                let updatedCount = 0;

                rawLines.forEach(rawLine => {
                    const line = rawLine.trim();
                    if (!line) return;

                    if (line === '=== INVENTARIO ===') { currentSection = 'INVENTARIO'; return; }
                    if (line === '=== FIADOS ===') { currentSection = 'FIADOS'; return; }
                    if (line === '=== HISTORIAL ===') { currentSection = 'HISTORIAL'; return; }

                    if (currentSection === 'INVENTARIO') {
                        const colonIdx = line.indexOf(':');
                        if (colonIdx !== -1) {
                            const name = line.slice(0, colonIdx).trim().replace(/^"|"$/g, '');
                            const parts = line.slice(colonIdx + 1).split(',').map(s => s.trim());
                            if (name && parts.length >= 2) {
                                let unitType = 'Unidades';
                                const uLower = parts[0].toLowerCase();
                                if (uLower.includes('kg') || uLower.includes('peso')) unitType = 'Kg';
                                else if (uLower.includes('paq')) unitType = 'Paquetes';

                                const stock = parseFloat(parts[1].replace(',', '.')) || 0;
                                const price = parts[2] ? (parseFloat(parts[2].replace(',', '.')) || 0) : 0;
                                const unitsPerPack = parts[3] ? (parseFloat(parts[3].replace(',', '.')) || 1) : 1;

                                const existingIdx = products.findIndex(p => p.name.toLowerCase() === name.toLowerCase());
                                if (existingIdx !== -1) {
                                    products[existingIdx].unitType = unitType;
                                    products[existingIdx].stock = stock;
                                    if (price > 0) products[existingIdx].price = price;
                                    products[existingIdx].unitsPerPack = unitsPerPack;
                                    updatedCount++;
                                } else {
                                    products.push({
                                        id: generateId(),
                                        name,
                                        unitType,
                                        stock,
                                        price,
                                        unitsPerPack
                                    });
                                    addedCount++;
                                }
                            }
                        }
                    } else if (currentSection === 'HISTORIAL') {
                        const cols = line.split('|');
                        if (cols.length >= 4) {
                            const [date, type, detail, totalStr, itemsRaw] = cols;
                            const items = (itemsRaw || '').split(';').filter(Boolean).map(it => {
                                const [iName, iQty, iUnit, iPrice] = it.split('|');
                                return { name: iName, qty: parseFloat(iQty) || 0, unitType: iUnit || 'Unidades', price: parseFloat(iPrice) || 0 };
                            });
                            history.push({
                                id: generateId(),
                                date,
                                type,
                                detail,
                                total: parseFloat(totalStr) || 0,
                                items,
                                paid: type === 'FIADO' ? false : true
                            });
                        }
                    }
                });

                saveData('Importación desde TXT');
                renderInventoryTable();
                renderEntryList();
                renderExitList();
                renderFiados();
                renderEarnings();
                renderHistory();
                showToast(`TXT importado: ${addedCount} nuevos, ${updatedCount} actualizados.`);
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        async function handlePdfUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            try {
                if (typeof pdfjsLib === 'undefined') {
                    showToast('La librería lectora de PDF aún está cargando. Intenta de nuevo en unos segundos.', 'warning');
                    return;
                }

                pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
                showToast('Leyendo archivo PDF...', 'warning');

                const arrayBuffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                let lines = [];

                for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                    const page = await pdf.getPage(pageNum);
                    const textContent = await page.getTextContent();
                    const rowMap = {};

                    textContent.items.forEach(item => {
                        const str = item.str.trim();
                        if (!str) return;
                        const existingY = Object.keys(rowMap).map(Number).find(y => Math.abs(y - item.transform[5]) <= 8);
                        const targetY = existingY !== undefined ? existingY : item.transform[5];
                        if (!rowMap[targetY]) rowMap[targetY] = [];
                        rowMap[targetY].push({ x: item.transform[4], text: str });
                    });

                    const sortedYs = Object.keys(rowMap).map(Number).sort((a, b) => b - a);
                    sortedYs.forEach(y => {
                        const rowText = rowMap[y]
                            .sort((a, b) => a.x - b.x)
                            .map(i => i.text)
                            .join(' ');
                        lines.push(rowText);
                    });
                }

                let updatedCount = 0;
                let addedCount = 0;
                const rowRegex = /^(.+?)\s+(Peso\s*\(Kg\)|Unidades|Paquetes)\s+([\d.,]+)\s*(Kg|Unidades|Paquetes)(?:\s+Bajo)?(?:\s+(\$[\d.,]+|No definido))?/i;

                lines.forEach(line => {
                    const match = line.match(rowRegex);
                    if (match) {
                        const name = match[1].trim();
                        if (!name || /producto\s+medida/i.test(name)) return;

                        const uLower = match[4].toLowerCase();
                        const unitType = uLower === 'kg' ? 'Kg' : (uLower === 'paquetes' ? 'Paquetes' : 'Unidades');
                        let rawStock = match[3];
                        if (rawStock.includes(',') && rawStock.includes('.')) {
                            rawStock = rawStock.replace(/\./g, '').replace(',', '.');
                        } else if (rawStock.includes(',')) {
                            rawStock = rawStock.replace(',', '.');
                        }
                        const stock = parseFloat(rawStock) || 0;

                        let price = 0;
                        if (match[5] && match[5].startsWith('$')) {
                            const rawPrice = match[5].replace('$', '').replace(/,/g, '');
                            price = parseFloat(rawPrice) || 0;
                        }

                        const existingIndex = products.findIndex(p => p.name.toLowerCase() === name.toLowerCase());
                        if (existingIndex !== -1) {
                            products[existingIndex].stock = stock;
                            products[existingIndex].unitType = unitType;
                            if (price > 0) products[existingIndex].price = price;
                            updatedCount++;
                        } else {
                            products.push({
                                id: generateId(),
                                name,
                                unitType,
                                price,
                                stock,
                                unitsPerPack: 1
                            });
                            addedCount++;
                        }
                    }
                });

                if (updatedCount > 0 || addedCount > 0) {
                    history.unshift({
                        id: generateId(),
                        date: getFormattedDateTime(),
                        type: 'ENTRADA',
                        detail: `Importación desde PDF (${addedCount} nuevos, ${updatedCount} actualizados)`,
                        items: [{ name: 'Actualización masiva PDF', qty: addedCount + updatedCount, unitType: 'Unidades', price: 0 }],
                        total: 0
                    });
                    saveData('Importación desde PDF');
                    renderInventoryTable();
                    renderEntryList();
                    renderExitList();
                    showToast(`PDF procesado: ${addedCount} agregados y ${updatedCount} actualizados.`);
                } else {
                    showToast('No se detectaron filas de inventario válidas en este PDF.', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error al leer el archivo PDF. Asegúrate de subir un reporte válido.', 'error');
            } finally {
                event.target.value = '';
            }
        }

