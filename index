        function confirmAddCart(e) {
            if (e) e.preventDefault();
            const id = document.getElementById('qty-modal-product-id').value;
            const rawVal = document.getElementById('qty-modal-input').value.trim().replace(',', '.');
            const qty = parseFloat(rawVal);
            const p = products.find(item => String(item.id) === String(id));

            if (!p) {
                showToast('Error al encontrar el producto.', 'error');
                closeQtyModal();
                return;
            }

            if (isNaN(qty) || qty <= 0) {
                showToast('Ingresa una cantidad válida mayor a 0.', 'warning');
                document.getElementById('qty-modal-input').focus();
                return;
            }

            const displayUnit = p.unitType === 'Paquetes' ? 'Unidades' : p.unitType;
            const existingInCart = cart.find(item => String(item.id) === String(id));
            const currentCartQty = existingInCart ? existingInCart.qty : 0;

            if (!isUnlimitedKg(p) && qty + currentCartQty > p.stock + 0.0001) {
                showToast(`Stock insuficiente. Máximo disponible: ${formatNumber(p.stock - currentCartQty)} ${displayUnit}`, 'error');
                return;
            }

            if (existingInCart) {
                existingInCart.qty += qty;
            } else {
                cart.push({
                    id: p.id,
                    name: p.name,
                    unitType: displayUnit,
                    price: p.price,
                    qty: qty
                });
            }

            closeQtyModal();
            renderCart();
            showToast(`Agregado a la factura.`);
        }

