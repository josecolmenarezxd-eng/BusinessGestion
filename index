        function getAccountStorageKey() {
            return `gp_account_data_${currentUser}`;
        }

        function loadAccountData() {
            if (!currentUser) return;
            const data = SafeStorage.get(getAccountStorageKey()) || {
                products: [],
                history: [],
                productPriceViews: {},
                revision: 0
            };
            products = Array.isArray(data.products) ? data.products : [];
            history = Array.isArray(data.history) ? data.history : [];
            productPriceViews = data.productPriceViews || {};
            lastSyncedRevision = Number(data.revision) || 0;
        }

        function requestOfflineNotificationPermission() {
            if ('Notification' in window && Notification.permission === 'default') {
                Notification.requestPermission().catch(() => {});
            }
        }

        function sendSystemNotification(title, body) {
            if ('Notification' in window && Notification.permission === 'granted') {
                try {
                    new Notification(title, { body });
                } catch (e) {}
            }
        }

        // ================= REAL-TIME MULTI-DEVICE SYNC (FIREBASE WEBSOCKETS) =================
        function initCrossDeviceSync() {
            if (syncChannel) syncChannel.close();
            if ('BroadcastChannel' in window) {
                syncChannel = new BroadcastChannel(`gp_sync_${currentUser}`);
                syncChannel.onmessage = (event) => {
                    const msg = event.data;
                    if (msg && msg.type === 'ACCOUNT_UPDATED' && msg.sourceDevice !== deviceId) {
                        applyIncomingAccountSync(msg.payload, msg.changeSummary || 'Cambio detectado en otra pestaña');
                    }
                };
            }

            if (activeFirebaseListener) {
                activeFirebaseListener.off();
                activeFirebaseListener = null;
            }
            if (activeSessionListener) {
                activeSessionListener.off();
                activeSessionListener = null;
            }

            if (cloudDb && currentUser) {
                const safeUser = sanitizeCloudKey(currentUser);
                activeFirebaseListener = cloudDb.ref(`inventories/${safeUser}`);
                activeFirebaseListener.on('value', (snapshot) => {
                    if (!snapshot.exists()) return;
                    const msgData = snapshot.val();
                    if (
                        msgData &&
                        msgData.sourceDevice !== deviceId &&
                        msgData.payload &&
                        Number(msgData.payload.revision) > Number(lastSyncedRevision)
                    ) {
                        applyIncomingAccountSync(
                            msgData.payload,
                            msgData.changeSummary || 'Actualización remota recibida'
                        );
                    }
                });

                activeSessionListener = cloudDb.ref(`sessions/${safeUser}`);
                activeSessionListener.on('child_changed', (snapshot) => {
                    const sess = snapshot.val();
                    if (sess && sess.deviceId !== deviceId && sess.status === 'LOGGED_OUT') {
                        pullRemoteCloudSync(true);
                    }
                });
            }
        }

        async function pushRemoteCloudSync(payload, changeSummary) {
            if (!currentUser) return;
            if (!cloudDb || !navigator.onLine) {
                pendingOfflineSync = true;
                updateCloudStatusIndicators();
                if (!navigator.onLine) {
                    sendSystemNotification('GestiónPro (Modo Offline)', `Cambio guardado localmente: ${changeSummary}. Se sincronizará al volver internet.`);
                }
                return;
            }
            try {
                const safeUser = sanitizeCloudKey(currentUser);
                await cloudDb.ref(`inventories/${safeUser}`).set({
                    sourceDevice: deviceId,
                    changeSummary: changeSummary || 'Actualización',
                    payload: payload
                });
                pendingOfflineSync = false;
                updateCloudStatusIndicators();
            } catch (e) {
                console.error('Error sincronizando con Firebase:', e);
                pendingOfflineSync = true;
                updateCloudStatusIndicators();
            }
        }

        async function pullRemoteCloudSync(announce) {
            if (!currentUser || !cloudDb || !navigator.onLine) return;
            try {
                const safeUser = sanitizeCloudKey(currentUser);
                const snapshot = await cloudDb.ref(`inventories/${safeUser}`).once('value');
                if (snapshot.exists()) {
                    const msgData = snapshot.val();
                    if (
                        msgData &&
                        msgData.payload &&
                        Number(msgData.payload.revision) > Number(lastSyncedRevision)
                    ) {
                        applyIncomingAccountSync(
                            msgData.payload,
                            announce ? (msgData.changeSummary || 'Actualización remota recibida') : 'Datos sincronizados desde la nube'
                        );
                    }
                }
            } catch (e) {
                console.error('Error descargando datos de Firebase:', e);
            }
        }

        function applyIncomingAccountSync(payload, summaryText) {
            if (!payload || Number(payload.revision) <= Number(lastSyncedRevision)) return;
            products = Array.isArray(payload.products) ? payload.products : [];
            history = Array.isArray(payload.history) ? payload.history : [];
            productPriceViews = payload.productPriceViews || {};
            lastSyncedRevision = Number(payload.revision);

            SafeStorage.set(getAccountStorageKey(), {
                products,
                history,
                productPriceViews,
                revision: lastSyncedRevision
            });

            renderInventoryTable();
            renderEntryList();
            renderExitList();
            renderPriceAdjustList();
            renderFiados();
            renderEarnings();
            renderHistory();

            if (summaryText) {
                showToast(`Sincronizado: ${summaryText}`, 'warning');
                sendSystemNotification(`Inventario (${currentUser}) actualizado`, summaryText);
            }
        }

        function updateConnectionBadge() {
            const badge = document.getElementById('sync-status-badge');
            if (!badge) return;
            if (!navigator.onLine) {
                badge.innerText = 'Offline (Local)';
                badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/30 text-amber-200 border border-amber-400/40';
            } else if (pendingOfflineSync) {
                badge.innerText = 'Sincronizando...';
                badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/30 text-amber-200 border border-amber-400/40';
            } else {
                badge.innerText = 'Sincronizado';
                badge.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-200 border border-emerald-400/30';
            }
        }

        window.addEventListener('online', () => {
            initGlobalPageBus();
            updateConnectionBadge();
            updateCloudStatusIndicators();
            flushPendingAccountPublishes();
            if (currentUser) {
                if (pendingOfflineSync) {
                    const currentPayload = SafeStorage.get(getAccountStorageKey());
                    if (currentPayload) pushRemoteCloudSync(currentPayload, 'Cambios offline sincronizados');
                }
                pullRemoteCloudSync(true);
                showToast('Conexión restaurada. Inventario sincronizado.');
                sendSystemNotification('GestiónPro Conectado', 'Tu inventario está sincronizado con tus dispositivos.');
            }
        });

        window.addEventListener('offline', () => {
            updateConnectionBadge();
            showToast('Sin internet: modo offline activo. Los cambios se guardan y se enviarán al reconectar.', 'warning');
            sendSystemNotification('GestiónPro Offline', 'Sin conexión. Tus cambios se guardarán localmente.');
        });

        window.addEventListener('storage', (e) => {
            if (currentUser && e.key === getAccountStorageKey() && e.newValue) {
                try {
                    const parsed = JSON.parse(e.newValue);
                    applyIncomingAccountSync(parsed, 'Cambio detectado en otra ventana');
                } catch (err) {}
            }
        });

        function saveData(changeSummary = 'Inventario actualizado') {
            if (!currentUser) return;
            const newRevision = Math.max(Date.now(), Number(lastSyncedRevision) + 1);
            lastSyncedRevision = newRevision;
            const payload = {
                products: [...products],
                history: [...history],
                productPriceViews: { ...productPriceViews },
                revision: newRevision
            };
