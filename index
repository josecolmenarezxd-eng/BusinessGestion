                    <div class="py-3 flex justify-between items-center gap-2">
                        <div class="min-w-0 flex-1">
                            <p class="font-semibold text-slate-800 text-sm truncate">${item.name}</p>
                            <p class="text-xs text-slate-500">${formatNumber(item.qty)} ${item.unitType}${item.price > 0 ? ` x ${unitPriceLabel}` : ''}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-slate-900 text-sm">${item.price > 0 ? subtotalLabel : '-'}</span>
                            <button onclick="removeFromCart('${item.id}')" class="text-slate-400 hover:text-rose-600 p-1 rounded-lg transition-colors">
                                ${ICONS.x}
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            if (cartCurrency === 'VES' && rate > 0) {
                totalEl.innerText = formatBs(total * rate);
                totalEl.className = 'text-xl text-emerald-600 block';
                if (secondaryTotalEl) secondaryTotalEl.innerText = `Equivalente: ${formatCurrency(total)}`;
            } else {
                totalEl.innerText = formatCurrency(total);
                totalEl.className = 'text-xl text-indigo-600 block';
                if (secondaryTotalEl) {
                    secondaryTotalEl.innerText = rate > 0 ? `Equivalente: ${formatBs(total * rate)}` : 'Configura tasa BCV para ver Bs.';
                }
            }
            checkoutBtn.disabled = false;
        }

        function checkoutCart() {
            if (cart.length === 0) return;

            const clientName = document.getElementById('cart-client-name').value.trim();
            if (transactionType === 'FIADO' && !clientName) {
                showToast('Por favor ingresa el nombre del cliente para el fiado.', 'warning');
                document.getElementById('cart-client-name').focus();
                return;
            }

            for (const item of cart) {
                const prod = products.find(p => String(p.id) === String(item.id));
                if (!prod || (!isUnlimitedKg(prod) && prod.stock < item.qty)) {
                    showToast(`Stock insuficiente para "${item.name}".`, 'error');
                    return;
                }
            }

            let grandTotal = 0;
            cart.forEach(item => {
                const prodIndex = products.findIndex(p => String(p.id) === String(item.id));
                const prod = products[prodIndex];
                if (!isUnlimitedKg(prod)) {
                    products[prodIndex].stock = Math.max(0, prod.stock - item.qty);
                }
                grandTotal += item.qty * item.price;
            });

            history.unshift({
                id: generateId(),
                date: getFormattedDateTime(),
                type: transactionType,
                clientName: transactionType === 'FIADO' ? clientName : '',
                paid: transactionType === 'FIADO' ? false : true,
                paidDate: null,
                detail: transactionType === 'FIADO' ? `Cliente: ${clientName}` : 'Venta al contado',
                items: [...cart],
                total: grandTotal
            });

            cart = [];
            document.getElementById('cart-client-name').value = '';
            saveData(transactionType === 'FIADO' ? `Fiado a ${clientName}` : 'Venta registrada');
            renderCart();
            renderExitList();
            showToast(transactionType === 'FIADO' ? 'Fiado registrado y descontado del stock.' : 'Venta completada con éxito.');
        }

        // ================= PRICE ADJUSTMENT SECTION LOGIC =================
        let priceAdjustOp = 'INC';
        let priceAdjustMode = 'FIXED';

        function renderPriceAdjustList() {
            const listEl = document.getElementById('price-adjust-product-list');
            if (!listEl) return;
            const query = document.getElementById('price-adjust-search').value.toLowerCase().trim();
            const filtered = products.filter(p => p.name.toLowerCase().includes(query));
            const rate = getActiveBcvRate();

            if (filtered.length === 0) {
                listEl.innerHTML = `
                    <div class="col-span-full p-8 text-center text-slate-400">
                        <p>${products.length === 0 ? 'No hay productos registrados en el inventario.' : 'No se encontraron productos.'}</p>
                    </div>
                `;
                return;
            }

            listEl.innerHTML = filtered.map(p => {
                const displayUnit = p.unitType === 'Paquetes' ? 'Unidades' : p.unitType;
                const bsSub = (p.price > 0 && rate > 0) ? ` <span class="text-slate-400">(${formatBs(p.price * rate)})</span>` : '';
                return `
                    <div onclick="selectProductForPriceAdjust('${p.id}')" class="p-3.5 rounded-xl border border-slate-200 hover:border-indigo-500 hover:bg-indigo-50/30 cursor-pointer transition-all flex justify-between items-center group">
                        <div>
                            <p class="font-bold text-slate-800 group-hover:text-indigo-700">${p.name}</p>
                            <div class="flex items-center gap-2 mt-1 text-xs">
                                <span class="text-indigo-600 font-semibold">${p.price > 0 ? `${formatCurrency(p.price)} / ${displayUnit}` : 'Sin precio ($0.00)'}</span>
                                ${bsSub}
                            </div>
                        </div>
                        <span class="bg-indigo-50 group-hover:bg-indigo-600 text-indigo-600 group-hover:text-white p-2 rounded-lg transition-colors">
                            ${ICONS.edit3}
                        </span>
                    </div>
                `;
            }).join('');
        }

        function selectProductForPriceAdjust(id) {
            const p = products.find(item => String(item.id) === String(id));
            if (!p) return;

            const displayUnit = p.unitType === 'Paquetes' ? 'Unidades' : p.unitType;
            document.getElementById('price-adjust-product-id').value = p.id;
            document.getElementById('price-adjust-value').value = '';

            document.getElementById('price-adjust-selected-info').innerHTML = `
                <div class="flex justify-between items-center">
                    <div>
                        <span class="text-xs font-bold uppercase text-indigo-600">Producto Seleccionado</span>
                        <h4 class="font-bold text-slate-900 text-base">${p.name}</h4>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-slate-400 block">Precio actual</span>
                        <span class="font-bold text-slate-800">${formatCurrency(p.price)} / ${displayUnit}</span>
                    </div>
                </div>
            `;

            document.getElementById('price-adjust-form').classList.remove('hidden');
            updatePriceAdjustPreview();
            setTimeout(() => document.getElementById('price-adjust-value').focus(), 50);
        }

        function setPriceAdjustOp(op) {
            priceAdjustOp = op;
            const btnInc = document.getElementById('btn-price-op-inc');
            const btnDec = document.getElementById('btn-price-op-dec');
            if (op === 'INC') {
                btnInc.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-emerald-600 text-white border-emerald-600 shadow-sm transition-all flex items-center justify-center gap-1';
                btnDec.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-white text-slate-600 border-slate-200 hover:bg-slate-50 transition-all flex items-center justify-center gap-1';
            } else {
                btnDec.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-rose-600 text-white border-rose-600 shadow-sm transition-all flex items-center justify-center gap-1';
                btnInc.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-white text-slate-600 border-slate-200 hover:bg-slate-50 transition-all flex items-center justify-center gap-1';
            }
            updatePriceAdjustLabel();
            updatePriceAdjustPreview();
        }

        function setPriceAdjustMode(mode) {
            priceAdjustMode = mode;
            const btnFixed = document.getElementById('btn-price-mode-fixed');
            const btnPercent = document.getElementById('btn-price-mode-percent');
            if (mode === 'FIXED') {
                btnFixed.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-indigo-600 text-white border-indigo-600 shadow-sm transition-all';
                btnPercent.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-white text-slate-600 border-slate-200 hover:bg-slate-50 transition-all';
            } else {
                btnPercent.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-indigo-600 text-white border-indigo-600 shadow-sm transition-all';
                btnFixed.className = 'py-2 px-3 rounded-xl text-xs font-bold border bg-white text-slate-600 border-slate-200 hover:bg-slate-50 transition-all';
            }
            updatePriceAdjustLabel();
            updatePriceAdjustPreview();
        }

        function updatePriceAdjustLabel() {
            const label = document.getElementById('price-adjust-value-label');
            if (!label) return;
            const actionText = priceAdjustOp === 'INC' ? 'Aumentar' : 'Disminuir';
            const unitText = priceAdjustMode === 'FIXED' ? '($)' : '(%)';
            label.innerText = `Valor a ${actionText} ${unitText}`;
        }

        function computeAdjustedPrice(currentPrice, val) {
            if (isNaN(val) || val <= 0) return currentPrice;
            let delta = priceAdjustMode === 'PERCENT' ? (currentPrice * (val / 100)) : val;
            let nextPrice = priceAdjustOp === 'INC' ? (currentPrice + delta) : (currentPrice - delta);
            return Math.max(0, Number(nextPrice.toFixed(4)));
        }

        function updatePriceAdjustPreview() {
            const id = document.getElementById('price-adjust-product-id').value;
            const p = products.find(item => String(item.id) === String(id));
            if (!p) return;

            const val = parseFloat(document.getElementById('price-adjust-value').value);
            const newPrice = computeAdjustedPrice(p.price, val);
            const rate = getActiveBcvRate();

            document.getElementById('price-adjust-old').innerText = formatCurrency(p.price);
            document.getElementById('price-adjust-new').innerText = formatCurrency(newPrice);
            document.getElementById('price-adjust-new-bs').innerText = rate > 0 ? formatBs(newPrice * rate) : 'Bs. 0,00';
        }

        function applyPriceAdjustment(e) {
            e.preventDefault();
            const id = document.getElementById('price-adjust-product-id').value;
            const val = parseFloat(document.getElementById('price-adjust-value').value);
            const index = products.findIndex(p => String(p.id) === String(id));

            if (index === -1 || isNaN(val) || val <= 0) {
                showToast('Ingresa un valor válido mayor a 0.', 'warning');
                return;
            }

            const oldPrice = products[index].price;
            const newPrice = computeAdjustedPrice(oldPrice, val);
            products[index].price = newPrice;

            saveData(`Precio ajustado: ${products[index].name}`);
            renderPriceAdjustList();
            selectProductForPriceAdjust(id);
            renderInventoryTable();
            renderExitList();

            const opSymbol = priceAdjustOp === 'INC' ? '+' : '-';
            const valLabel = priceAdjustMode === 'PERCENT' ? `${val}%` : formatCurrency(val);
            showToast(`Precio de "${products[index].name}" actualizado (${opSymbol}${valLabel} → ${formatCurrency(newPrice)}).`);
        }

        // ================= FIADOS (ACCOUNTS RECEIVABLE) LOGIC =================
        function toggleFiadoStatus(historyId) {
            const record = history.find(h => String(h.id) === String(historyId) && h.type === 'FIADO');
            if (!record) return;

            record.paid = !record.paid;
            record.paidDate = record.paid ? getFormattedDateTime() : null;
            saveData(record.paid ? `Fiado cobrado` : `Fiado marcado pendiente`);
            renderFiados();
            renderEarnings();
            showToast(record.paid ? '¡Fiado marcado como PAGADO!' : 'Fiado marcado como PENDIENTE.', record.paid ? 'success' : 'warning');
        }

        function renderFiados() {
            const tbody = document.getElementById('fiados-table-body');
            if (!tbody) return;

            const search = document.getElementById('fiados-search').value.toLowerCase().trim();
            const filter = document.getElementById('fiados-filter').value;

            const fiadosList = history.filter(h => {
                if (h.type !== 'FIADO') return false;
                const clientLabel = (h.clientName || h.detail || '').toLowerCase();
                if (search && !clientLabel.includes(search)) return false;
                if (filter === 'PENDING' && h.paid) return false;
                if (filter === 'PAID' && !h.paid) return false;
                return true;
            });

            if (fiadosList.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="p-8 text-center text-slate-400">
                            No hay registros de fiados que coincidan con tu búsqueda.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = fiadosList.map(f => {
                const clientDisplay = f.clientName || f.detail.replace(/^Cliente:\s*/i, '');
                const itemsSummary = f.items.map(i => `${formatNumber(i.qty)} ${i.unitType} de ${i.name}`).join(', ');
                const isPaid = Boolean(f.paid);

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors ${isPaid ? 'bg-slate-50/40' : ''}">
                        <td class="p-4 font-bold text-slate-900">${clientDisplay}</td>
                        <td class="p-4 text-xs text-slate-500 whitespace-nowrap">
                            <div>${f.date}</div>
                            ${isPaid && f.paidDate ? `<div class="text-emerald-600 font-medium mt-0.5">Pagado: ${f.paidDate}</div>` : ''}
                        </td>
                        <td class="p-4 text-xs text-slate-600 max-w-xs">${itemsSummary}</td>
                        <td class="p-4 font-bold ${isPaid ? 'text-slate-500 line-through' : 'text-amber-700'}">
                            ${f.total > 0 ? formatCurrency(f.total) : '<span class="text-slate-400 font-normal">Sin precio</span>'}
                        </td>
                        <td class="p-4">
                            ${isPaid
                                ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">${ICONS.checkCircle2} Pagado</span>`
                                : `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">${ICONS.clock} Debe</span>`
                            }
                        </td>
                        <td class="p-4 text-right">
                            <button onclick="toggleFiadoStatus('${f.id}')" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors ${isPaid ? 'bg-slate-100 hover:bg-slate-200 text-slate-600' : 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm'}">
                                ${isPaid ? 'Marcar Pendiente' : 'Marcar Pagado'}
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ================= EARNINGS (GANANCIAS) LOGIC =================
        let earningsPeriod = 'DAILY';

        function parseSpanishDate(dateStr) {
            if (!dateStr) return null;
            const parts = dateStr.trim().split(' ');
            const dateParts = parts[0].split('/');
            if (dateParts.length !== 3) return null;
            const day = parseInt(dateParts[0], 10);
            const month = parseInt(dateParts[1], 10) - 1;
            const year = parseInt(dateParts[2], 10);
            let hours = 0, minutes = 0;
            if (parts[1]) {
                const timeParts = parts[1].split(':');
                hours = parseInt(timeParts[0], 10) || 0;
                minutes = parseInt(timeParts[1], 10) || 0;
            }
            const d = new Date(year, month, day, hours, minutes);
            return isNaN(d.getTime()) ? null : d;
        }

        function isDateInPeriod(dateObj, period) {
            if (!dateObj) return false;
            const now = new Date();
            const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());

            if (period === 'DAILY') {
                return dateObj >= startOfToday;
            }
            if (period === 'WEEKLY') {
                const dayOfWeek = now.getDay();
                const diffToMonday = dayOfWeek === 0 ? 6 : dayOfWeek - 1;
                const startOfWeek = new Date(now.getFullYear(), now.getMonth(), now.getDate() - diffToMonday);
                return dateObj >= startOfWeek;
            }
            if (period === 'MONTHLY') {
                const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
                return dateObj >= startOfMonth;
            }
            return true;
        }

        function calculatePeriodMetrics(period) {
            let cash = 0;
            let credit = 0;
            const matchingTx = [];

            history.forEach(h => {
                if (h.type !== 'VENTA' && h.type !== 'FIADO') return;
                const txDate = parseSpanishDate(h.date);
                if (!isDateInPeriod(txDate, period)) return;

                const amount = Number(h.total) || 0;
                if (h.type === 'VENTA') {
                    cash += amount;
                    matchingTx.push({ ...h, modality: 'CONTADO' });
                } else if (h.type === 'FIADO') {
                    if (h.paid) {
                        cash += amount;
                        matchingTx.push({ ...h, modality: 'FIADO COBRADO' });
                    } else {
                        credit += amount;
                        matchingTx.push({ ...h, modality: 'FIADO PENDIENTE' });
                    }
                }
            });

            return {
                cash,
                credit,
                total: cash + credit,
                transactions: matchingTx
            };
        }

        function setEarningsPeriod(period) {
            earningsPeriod = period;
            const periods = [
                { id: 'btn-period-daily', key: 'DAILY' },
                { id: 'btn-period-weekly', key: 'WEEKLY' },
                { id: 'btn-period-monthly', key: 'MONTHLY' }
            ];
            periods.forEach(p => {
                const btn = document.getElementById(p.id);
                if (!btn) return;
                if (p.key === period) {
                    btn.className = 'flex-1 sm:flex-none px-4 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-sm';
                } else {
                    btn.className = 'flex-1 sm:flex-none px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-slate-200';
                }
            });
            renderEarnings();
        }

        function renderEarnings() {
            const currentMetrics = calculatePeriodMetrics(earningsPeriod);

            const cashEl = document.getElementById('earn-cash-amount');
            const creditEl = document.getElementById('earn-credit-amount');
            const totalEl = document.getElementById('earn-total-amount');
            if (cashEl) cashEl.innerText = formatCurrency(currentMetrics.cash);
            if (creditEl) creditEl.innerText = formatCurrency(currentMetrics.credit);
            if (totalEl) totalEl.innerText = formatCurrency(currentMetrics.total);

            const summaryBody = document.getElementById('earnings-summary-body');
            if (summaryBody) {
                const daily = calculatePeriodMetrics('DAILY');
                const weekly = calculatePeriodMetrics('WEEKLY');
                const monthly = calculatePeriodMetrics('MONTHLY');

                const rows = [
                    { label: 'Hoy (Diario)', data: daily, active: earningsPeriod === 'DAILY' },
                    { label: 'Esta Semana (Semanal)', data: weekly, active: earningsPeriod === 'WEEKLY' },
                    { label: 'Este Mes (Mensual)', data: monthly, active: earningsPeriod === 'MONTHLY' }
                ];

                summaryBody.innerHTML = rows.map(r => `
                    <tr class="${r.active ? 'bg-indigo-50/40 font-semibold' : 'hover:bg-slate-50/80'} transition-colors">
                        <td class="p-4 text-slate-900">${r.label}</td>
                        <td class="p-4 font-bold text-emerald-600">${formatCurrency(r.data.cash)}</td>
                        <td class="p-4 font-bold text-amber-600">${formatCurrency(r.data.credit)}</td>
                        <td class="p-4 font-bold text-indigo-700 text-right">${formatCurrency(r.data.total)}</td>
                    </tr>
                `).join('');
            }

            const detailBody = document.getElementById('earnings-detail-body');
            const txCountEl = document.getElementById('earnings-tx-count');
            if (txCountEl) {
                txCountEl.innerText = `${currentMetrics.transactions.length} ${currentMetrics.transactions.length === 1 ? 'operación' : 'operaciones'}`;
            }

            if (detailBody) {
                if (currentMetrics.transactions.length === 0) {
                    detailBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="p-8 text-center text-slate-400">
                                No hay ventas ni fiados registrados en este período.
                            </td>
                        </tr>
                    `;
                } else {
                    detailBody.innerHTML = currentMetrics.transactions.map(tx => {
                        const isCreditPending = tx.modality === 'FIADO PENDIENTE';
                        const badgeClass = isCreditPending
                            ? 'bg-amber-50 text-amber-700 border border-amber-200'
                            : 'bg-emerald-50 text-emerald-700 border border-emerald-200';
                        const itemsSummary = tx.items.map(i => `${formatNumber(i.qty)} ${i.unitType} de ${i.name}`).join(', ');

                        return `
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="p-4 text-xs font-medium text-slate-500 whitespace-nowrap">${tx.date}</td>
                                <td class="p-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold ${badgeClass}">
                                        ${tx.modality}
                                    </span>
                                </td>
                                <td class="p-4 font-medium text-slate-800">${tx.detail}</td>
                                <td class="p-4 text-slate-600 text-xs max-w-xs">${itemsSummary}</td>
                                <td class="p-4 text-right font-bold ${isCreditPending ? 'text-amber-600' : 'text-emerald-600'}">
                                    ${formatCurrency(tx.total)}
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
            }

            lucide.createIcons();
        }

        // ================= HISTORY LOGIC =================
        function renderHistory() {
            const tbody = document.getElementById('history-table-body');
            if (!tbody) return;
            const filter = document.getElementById('history-filter').value;
            const filtered = filter === 'ALL' ? history : history.filter(h => h.type === filter);

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="p-8 text-center text-slate-400">
                            No hay movimientos registrados para este filtro.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filtered.map(h => {
                let badgeStyle = 'bg-slate-100 text-slate-700';
                if (h.type === 'ENTRADA') badgeStyle = 'bg-emerald-50 text-emerald-700 border border-emerald-200';
                if (h.type === 'VENTA') badgeStyle = 'bg-indigo-50 text-indigo-700 border border-indigo-200';
                if (h.type === 'FIADO') badgeStyle = 'bg-amber-50 text-amber-700 border border-amber-200';

                const itemsSummary = h.items.map(i => `${formatNumber(i.qty)} ${i.unitType} de ${i.name}`).join(', ');

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-4 text-xs font-medium text-slate-500 whitespace-nowrap">${h.date}</td>
                        <td class="p-4">
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold ${badgeStyle}">
                                ${h.type}
                            </span>
                        </td>
                        <td class="p-4 font-medium text-slate-800">${h.detail}</td>
                        <td class="p-4 text-slate-600 text-xs max-w-xs">${itemsSummary}</td>
                        <td class="p-4 text-right font-bold ${h.type === 'ENTRADA' ? 'text-emerald-600' : 'text-slate-900'}">
                            ${h.total > 0 ? formatCurrency(h.total) : '<span class="text-slate-400 font-normal">-</span>'}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ================= INITIALIZATION =================
        window.onload = function() {
            lucide.createIcons();
            syncBcvUi();
            fetchBcvRates(false);
            updateConnectionBadge();
            flushPendingAccountPublishes();

            const savedSession = SafeStorage.get('gp_active_session');
            if (savedSession && savedSession.username) {
                startUserSession(savedSession.username, savedSession.syncRoom || savedSession.username);
            }
        };
    </script>
