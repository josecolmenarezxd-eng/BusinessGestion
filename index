            if (!p || (!unlimited && p.stock <= 0)) return;

            const displayUnit = p.unitType === 'Paquetes' ? 'Unidades' : p.unitType;

            document.getElementById('qty-modal-product-id').value = p.id;
            document.getElementById('qty-modal-prod-name').innerText = p.name;
            document.getElementById('qty-modal-prod-stock').innerText = `Disponible: ${unlimited ? 'No definido (Ilimitado)' : `${formatNumber(p.stock)} ${displayUnit}`}${p.price > 0 ? ` | Precio: ${formatCurrency(p.price)}` : ''}`;
