        async function logoutAccount() {
            const departingUser = currentUser;
            const currentPayload = departingUser ? (SafeStorage.get(`gp_account_data_${departingUser}`) || {
                products: [...products],
                history: [...history],
                productPriceViews: { ...productPriceViews },
                revision: Math.max(Date.now(), Number(lastSyncedRevision) + 1)
            }) : null;

            if (departingUser && currentPayload) {
                SafeStorage.set(`gp_account_data_${departingUser}`, currentPayload);
                broadcastGlobalEvent({
                    type: 'SESSION_EVENT',
                    action: 'LOGGED_OUT',
                    username: departingUser,
                    latestPayload: currentPayload
                });
                if (cloudDb && navigator.onLine) {
                    const safeUser = sanitizeCloudKey(departingUser);
                    try {
                        await cloudDb.ref(`inventories/${safeUser}`).set({
                            sourceDevice: deviceId,
                            changeSummary: 'Datos guardados al cerrar sesión',
                            payload: currentPayload
                        });
                        await cloudDb.ref(`sessions/${safeUser}/${deviceId}`).set({
                            username: departingUser,
                            deviceId: deviceId,
                            status: 'LOGGED_OUT',
                            updatedAt: Date.now()
                        });
                    } catch (e) {}
                }
            }

            currentUser = null;
            cart = [];
            SafeStorage.remove('gp_active_session');
            if (syncChannel) {
                syncChannel.close();
                syncChannel = null;
            }
            if (activeFirebaseListener) {
                activeFirebaseListener.off();
                activeFirebaseListener = null;
            }
            if (activeSessionListener) {
                activeSessionListener.off();
                activeSessionListener = null;
            }
            document.getElementById('app-wrapper').classList.add('hidden');
